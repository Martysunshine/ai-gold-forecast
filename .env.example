# Optional settings. Copy to .env (git-ignored) in the repository root; real environment variables take precedence.
# The app runs without any of these.

# --- Prices -----------------------------------------------------------------
GOLD_SYMBOL=GC=F
GOLD_HISTORY_RANGE=5y
GOLD_CACHE_TTL_SECONDS=900
GOLD_NEWS_TTL_SECONDS=900
GOLD_HTTP_TIMEOUT=12
# Never call external data providers; use cached data / uploaded CSV only.
# GOLD_OFFLINE=1
# GOLD_DATA_DIR=./backend/data

# --- Background jobs -------------------------------------------------------
# The web app starts an in-process worker only when no standalone worker (launchd) is running. Set 0 to never do so.
# GOLD_EMBEDDED_WORKER=1
# Which runtime is operating (set by the launchd plist / container; shown on the Learning page): launchd | container | web-embedded | manual
# GOLD_RUNTIME=manual
# Optional shared secret for state-changing API calls (POST/PUT/DELETE). Without it, only this machine and this app's own origin may change anything.
# GOLD_API_TOKEN=

# --- Optional: GLD ETF comparison via Alpaca market data (read-only) ---------
# Use paper-trading or market-data keys. Only market data is requested; no orders are placed.
# Keys stay on the server and are never shown in the interface or API responses. Never commit .env.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# 'iex' works on the free plan; 'sip' requires a paid data subscription.
ALPACA_DATA_FEED=iex

# --- Alerts: SMS through n8n (hosted scheduling) -------------------------------
# Default is SIMULATION: nothing is sent and n8n is never contacted. See n8n/README.md for the setup.
# The recipient phone number and the Twilio credentials live ONLY inside n8n, never here.
# GOLD_ALERTS_MODE=live
# N8N_WEBHOOK_BASE=https://YOUR-INSTANCE.app.n8n.cloud/webhook
# N8N_AUTH_SECRET=a-long-random-string          # the same value is entered in n8n as the Header Auth credential
# N8N_AUTH_HEADER=X-Gold-Secret
# Where SMS links point. Default: <N8N_WEBHOOK_BASE>/gold-review (served by n8n, so it works while your Mac sleeps).
# ALERT_REVIEW_BASE_URL=
