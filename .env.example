# Optional settings. Copy to .env (git-ignored) in the repository root; real environment variables take precedence.
# The app runs without any of these.

# --- Prices -----------------------------------------------------------------
GOLD_SYMBOL=GC=F
GOLD_HISTORY_RANGE=5y
GOLD_CACHE_TTL_SECONDS=900
GOLD_NEWS_TTL_SECONDS=900
GOLD_HTTP_TIMEOUT=12
# Never call external data providers; use cached data / uploaded CSV only.
# GOLD_OFFLINE=1
# GOLD_DATA_DIR=./backend/data

# --- Optional: GLD ETF comparison via Alpaca market data (read-only) ---------
# Use paper-trading or market-data keys. Only market data is requested; no orders are placed.
# Keys stay on the server and are never shown in the interface or API responses. Never commit .env.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# 'iex' works on the free plan; 'sip' requires a paid data subscription.
ALPACA_DATA_FEED=iex
